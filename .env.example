# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mtbf

# Application Configuration
DEBUG=false
ENVIRONMENT=development

# API Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mtbf
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# KPI Scheduling Configuration
KPI_ROLLING_SCHEDULE_MINUTE=*
KPI_ROLLING_SCHEDULE_HOUR=*
KPI_CALENDAR_SCHEDULE_MINUTE=0
KPI_CALENDAR_SCHEDULE_HOUR=0
KPI_BATCH_SIZE=100

# Alerting Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=alerts@mtbf-platform.com
SMTP_FROM_NAME=MTBF Platform Alerts

# Webhook Configuration
WEBHOOK_TIMEOUT_SECONDS=30
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_BACKOFF_SECONDS=5
