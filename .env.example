# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=mtbf

# Application Configuration
DEBUG=false
ENVIRONMENT=development

# API Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/mtbf
REDIS_URL=redis://redis:6379/0

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# JWT Authentication
JWT_SECRET=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# KPI Scheduling Configuration
KPI_ROLLING_SCHEDULE_MINUTE=*
KPI_ROLLING_SCHEDULE_HOUR=*
KPI_CALENDAR_SCHEDULE_MINUTE=0
KPI_CALENDAR_SCHEDULE_HOUR=0
KPI_BATCH_SIZE=100

# CSV Import Configuration
CSV_IMPORT_MAX_BYTES=5242880
CSV_IMPORT_STORAGE_PATH=./tmp/csv_imports
CSV_IMPORT_IDEMPOTENCY_TTL_MINUTES=60
CSV_IMPORT_ERROR_SAMPLE_SIZE=10
